# ═══════════════════════════════════════════════════════════════
# ПОЛНЫЙ ПЕРЕХОД НА ЯНДЕКС — пример .env
# ═══════════════════════════════════════════════════════════════

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# GigaChat (Сбер, РФ)
GIGACHAT_CREDENTIALS=your_gigachat_credentials
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=false

# Яндекс.Диск — таблица клиентов
# Как получить: https://oauth.yandex.ru → Создать приложение → Получить токен
YANDEX_DISK_TOKEN=your_yandex_oauth_token
YANDEX_DISK_FILE_PATH=/salon-bot/clients.xlsx

# Яндекс.Календарь — CalDAV
# Как получить:
#   1. https://id.yandex.ru/security/app-passwords → Создать пароль для "Календарь"
#   2. https://calendar.yandex.ru → Шестерёнка → Экспорт → Скопировать CalDAV URL
YANDEX_CALDAV_URL=https://caldav.yandex.ru/calendars/your_login/events-default/
YANDEX_CALDAV_USERNAME=your_login@yandex.ru
YANDEX_CALDAV_PASSWORD=your_16_char_app_password

# Салон
SALON_NAME=Аарон
SALON_TIMEZONE=Europe/Moscow
ADDRESS=Ваш адрес
WORK_START_HOUR=10
WORK_END_HOUR=20
SERVICES_CSV=services_pricelist.csv

# Render (опционально)
# WEBHOOK_URL=https://your-app.onrender.com/webhook
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
